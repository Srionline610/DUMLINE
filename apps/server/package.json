{
  "name": "@dumline/server",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "build": "prisma generate --config src/prisma/prisma.config.ts",
    "start": "ts-node --transpile-only src/index.ts",
    "start:prod": "prisma migrate deploy --config src/prisma/prisma.config.ts && ts-node --transpile-only src/prisma/seed.ts && ts-node --transpile-only src/index.ts",
    "migrate": "npx prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy --config src/prisma/prisma.config.ts",
    "seed": "ts-node src/prisma/seed.ts",
    "generate": "prisma generate --config src/prisma/prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --transpile-only test/runner.ts"
  },
  "dependencies": {
    "@dumline/shared": "*",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "dotenv": "^18.0.10",
    "express": "5.3.0",
    "mariadb": "3.5.4",
    "socket.io": "4.8.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prisma": "7.10.1",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.3"
  }
}
