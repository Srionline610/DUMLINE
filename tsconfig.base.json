{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@dumline/shared": ["./packages/shared/src/index.ts"],
      "@dumline/shared/*": ["./packages/shared/src/*"]
    }
  }
}
