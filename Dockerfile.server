# Production Dockerfile for DUMLINE Backend API & Real-Time Engine
FROM node:22-alpine AS base

WORKDIR /app

RUN apk add --no-cache libc6-compat

# Copy package manifests for all workspaces
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/server/package.json ./apps/server/
COPY apps/web/package.json ./apps/web/

# Install dependencies cleanly
RUN npm ci

# Copy shared package and server source code
COPY packages/shared ./packages/shared
COPY apps/server ./apps/server

# Build shared types/schemas and generate Prisma Client
RUN npm run build --workspace=@dumline/shared
RUN npm run build --workspace=@dumline/server

# Expose backend port
EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

# Start server
CMD ["npm", "run", "start", "--workspace=@dumline/server"]
