# Environment variables
# -------------------------------------------------
# MySQL connection string (replace with your credentials or cloud provider URL)
# Example local: mysql://dumline_user:DumlineTemp2026!@localhost:3306/dumline_dev
# Example cloud: mysql://user:password@host:3306/dbname?sslaccept=strict
DATABASE_URL="mysql://dumline_user:<PASSWORD>@localhost:3306/dumline_dev"

# JWT secret for authentication (minimum 32 characters in production)
JWT_SECRET="your_jwt_secret_here_must_be_at_least_32_characters"

# Server Port, Host, and Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Production CORS origin(s) (comma-separated for multiple origins)
# Example: https://dumline.com,https://dumline.vercel.app,https://dumline.onrender.com
CORS_ORIGIN=""

# Optional: Google Gemini API Key for AI-assisted preparation-time estimation
# When left blank or unset, system seamlessly uses the verified deterministic fallback formula
GEMINI_API_KEY=""

# Frontend Web Client URLs (used by apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

