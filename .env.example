# Environment variables
# -------------------------------------------------
# MySQL connection string (replace with your credentials)
# Example: mysql://dumline_user:your_password@localhost:3306/dumline_dev
DATABASE_URL="mysql://dumline_user:<PASSWORD>@localhost:3306/dumline_dev"

# JWT secret for authentication (use a strong random value in production)
JWT_SECRET="your_jwt_secret_here"

# Server Port and Environment
PORT=3000
NODE_ENV=development

# Optional: Google Gemini API Key for AI-assisted preparation-time estimation
# When left blank or unset, system seamlessly uses the verified deterministic fallback formula
GEMINI_API_KEY=""

